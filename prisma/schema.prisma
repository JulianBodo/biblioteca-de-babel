// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String     @unique
  DNI   String     @unique
  userStatusId Int

  userStatus UserStatus @relation(fields: [userStatusId], references: [id])


  loans Loan[]
}

model Loan {
  id             Int          @id @default(autoincrement())
  userId         Int
  bookId         Int
  returnStatusId Int
  loanDate       DateTime
  returnDate     DateTime?

  user         User         @relation(fields: [userId], references: [id])
  book         Book         @relation(fields: [bookId], references: [id])
  returnStatus ReturnStatus @relation(fields: [returnStatusId], references: [id])

}

// Intermediate table for the many-to-many relation between User and Loan through LoanUser


model Book {
  id              Int       @id @default(autoincrement())
  isbn            String    @unique
  title           String
  publicationYear Int
  authorPublisherId Int
  genreId         Int
  publisherId     Int

  
  authorPublisher AuthorPublisher @relation(fields: [authorPublisherId], references: [id])
  genre     Genre     @relation(fields: [genreId], references: [id])

  loans Loan[]
}

model Publisher {
  id               Int               @id @default(autoincrement())
  name             String

  authorPublishers AuthorPublisher[]

 
}

model Author {
  id        Int               @id @default(autoincrement())
  firstName String
  lastName  String

  authorPublishers AuthorPublisher[]

 
}

// Intermediate table for the many-to-many relation between Author and Publisher
model AuthorPublisher {
  id          Int      @id @default(autoincrement())
  authorId    Int
  publisherId Int

  author    Author    @relation(fields: [authorId], references: [id])
  publisher Publisher @relation(fields: [publisherId], references: [id])

  books Book[]
}

model UserStatus {
  id     Int    @id @default(autoincrement())
  status String

  users User[]
}

model ReturnStatus {
  id     Int    @id @default(autoincrement())
  status String

  loans Loan[]
}

model Genre {
  id   Int    @id @default(autoincrement())
  name String

  books Book[]
}
