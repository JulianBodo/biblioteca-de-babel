{
  "name": "biblioteca-de-babel",
  "version": "1.0.0",
  "description": "Sistema de gestión bibliotecaria.",
  "type": "module",
  "main": "src/init.ts",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test",
    "test:api:ui": "playwright test --ui",
    "test:api:report": "npm run allure:generate && npm run allure:open",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "dev": "nodemon --watch src --ext ts --exec tsx src/init.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-db.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JulianBodo/biblioteca-de-babel.git"
  },
  "author": "Bodo Julián, Cabrera Federico, Medina Manuel",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JulianBodo/biblioteca-de-babel/issues"
  },
  "homepage": "https://github.com/JulianBodo/biblioteca-de-babel#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@prisma/config": "^7.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/swagger-ui-express": "^4.1.8",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "nodemon": "^3.1.14",
    "openapi-types": "^12.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "braces": "3.0.3",
    "chokidar": "^4.0.0",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.12.0",
    "undici": "^6.21.1"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "workerd@1.20260901.1": true
  }
}
